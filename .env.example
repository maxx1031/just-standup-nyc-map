# Copy to .env, fill in, then:  set -a; source .env; set +a
# Daytona (dashboard -> API keys). "Manage secrets" / "snapshots" permissions are optional.
DAYTONA_API_KEY=
# AWS with Amazon Bedrock access (Claude). Temporary STS credentials work; refresh them when they expire.
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# SurrealDB Cloud: already in config/surreal.env (committed, shared test login) - source that file too.
# Optional: your own Daytona server instead of the team's shared one (own URL; deploy up/down only touch it).
# STANDUP_INSTANCE=your-name
# Optional: Arize AX tracing.
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=just-standup
